[ext_resource type="Script" path="res://scripts/resources/codex_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"anne_frank"
title = "Anne Frank (1929-1945)"
body = "Born in Frankfurt am Main; the Frank family fled to Amsterdam in 1933 to escape Nazi persecution. After the German occupation of the Netherlands began in May 1940, the family went into hiding in a concealed annex above her father Otto's business at 263 Prinsengracht on 6 July 1942.

For 25 months Anne, her parents Otto and Edith, her sister Margot, and four others lived in the achterhuis (\"back house\"), sustained by employees of Otto's company. Anne kept a diary throughout. On 4 August 1944 the annex was raided by the Sicherheitsdienst on a tip-off that has never been conclusively identified. All eight occupants were deported to Auschwitz; Anne and Margot were transferred to Bergen-Belsen, where both died of typhus in February or March 1945, weeks before the British liberation of the camp.

Anne's diary, preserved by Miep Gies and published by Otto Frank in 1947, is one of the most-read accounts of the Holocaust and a foundational text of Holocaust education."
sources = "Sources: Anne Frank Stichting, USHMM, Yad Vashem, Het Achterhuis (1947)."
